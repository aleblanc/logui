{% extends '@LogUi/logui/layout.html.twig' %}

{% block content %}
<h2>Log files</h2>
{% if sources is empty %}
    <p class="ctx">No log files discovered. Configure <code>log_ui.external_logs</code> or enable <code>discover_monolog</code>.</p>
{% else %}
{# Biggest first: on a server you open this page to find out what is eating the disk. #}
<table>
    <thead><tr><th>Source</th><th>Path</th><th class="num">Size</th></tr></thead>
    <tbody>
    {% for s in sources|sort((a, b) => b.size <=> a.size) %}
        <tr>
            <td><a href="{{ ui_path }}/logs/view?ref={{ s.ref|url_encode }}">{{ s.label }}</a></td>
            <td class="ctx">{{ s.ref }}</td>
            <td class="num{{ s.size > 536870912 ? ' hl-danger' : (s.size > 104857600 ? ' hl-warning') }}">{{ s.size_human }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
<p class="ctx">{{ sources|length }} file(s) · {{ total_size }} on disk</p>
{% endif %}
{% endblock %}
